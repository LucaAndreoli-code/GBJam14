script = ExtResource("15_garbb")
lines = ["IMPERIAL DISPATCH
Site: Outer Ruins
Assignment: recover lost treasures.", "Our scouts found a small section
close to the surface.
Start there, Sugi.", "Conditions: dark, but stable.
Torches were left by those before you.", "Take your time and learn the ways
of the ruins. Deeper ones await."]
must_play_once = false
