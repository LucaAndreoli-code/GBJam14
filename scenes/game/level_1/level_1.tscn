[node name="Signs" type="Node2D" parent="." unique_id=560674007]

[node name="Sign1" parent="Signs" unique_id=1704938251 instance=ExtResource("22_4dlj5")]
position = Vector2(29, 72)
lines = ["Welcome, Sugi!", "It's been a while since your last crawl, so we've left these signs as a reminder.", "Lesson 1: use the D-Pad (WASD) to move around the ruins.", "Remember: the mission only counts if you make it back out."]

[node name="Sign2" parent="Signs" unique_id=1525943991 instance=ExtResource("22_4dlj5")]
position = Vector2(119, 231)
lines = ["Time for another lesson... number 2!", "This door seems locked. What could help? A key, maybe? Let's go find it!", "Once you do, press A (X) to pick it up."]

[node name="Sign3" parent="Signs" unique_id=1312508534 instance=ExtResource("22_4dlj5")]
position = Vector2(60, 344)
lines = ["Your torch is your only light, and it won't last forever.", "Press A (X) to pick up abandoned torches and gain more time.", "Trust me, you don't want to see this place in the dark..."]

[node name="Sign4" parent="Signs" unique_id=538047770 instance=ExtResource("22_4dlj5")]
position = Vector2(92, 488)
lines = ["Look, digging sites!", "Dig here to find rare treasures. Once you've collected enough, you can leave this place.", "How? Just reach a door with light on the other side.", "One last thing: you can only dig while your torch is ON."]
