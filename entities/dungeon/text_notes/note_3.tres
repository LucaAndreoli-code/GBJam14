[resource]
script = ExtResource("1_loeot")
id = 3
lines = ["You pick up a note from the floor. It looks very old and worn.
The title reads: \"Traveller’s Note\".
You keep reading...", "After spending a few days in the city, I’ve learned that the people here have a large reverence for Nature.", "I stumbled across a young girl watering a dried up flower bed the other day. She wasn’t even from the area.", "She had been passing through and stopped to water them.
This is probably why so many plants are growing all over the place."]
metadata/_custom_type_script = "uid://cqvc87ux42c8t"
